@startuml image9
title Biểu đồ trạng thái module xem thống kê khách hàng theo doanh thu (State Machine Diagram - View Customer Statistics)

skinparam state {
    BackgroundColor #F8F9FA
    BorderColor #0D6EFD
    ArrowColor #212529
    StartColor #0D6EFD
    EndColor #0D6EFD
}

[*] --> S1 : Start

state "Display manager\nmain screen" as S1
state "Display report\nselection\nscreen" as S2
state "Display Customer\nreport by revenue\nscreen" as S3
state "Display transactions\nof particular customer" as S4

S1 --> S2 : Select view report feature
S2 --> S3 : select report type and dates
S3 --> S4 : Select a customer
S4 --> S3 : Click Back
S3 --> S2 : Click Back
S4 --> [*] : Click close

@enduml
