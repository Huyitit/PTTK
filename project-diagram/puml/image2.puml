@startuml image2
skinparam packageStyle rectangle
skinparam actorStyle awesome
left to right direction

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #0D6EFD
    ArrowColor #212529
}

actor "User 3\n(Người dùng)" as User
actor "Customer 3\n(Khách hàng)" as Customer

Customer -up-|> User

rectangle "Cinema" as System {
    usecase "Login 3" as UC_Login
    usecase "Search Movie 3" as UC_SearchMovie
    usecase "Search Movie For Customer 3" as UC_SearchCust
    usecase "View Movie Detail 3" as UC_ViewDetail
}

' Kế thừa Use Case
UC_SearchCust -up-|> UC_SearchMovie

' Quan hệ Include & Extend
UC_SearchCust ..> UC_Login : <<include>>
UC_ViewDetail ..> UC_SearchCust : <<extend>>

' Quan hệ Association nét liền
User -- UC_Login
Customer -- UC_SearchCust

@enduml
